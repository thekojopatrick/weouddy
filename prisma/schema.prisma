generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoomActivityType {
  JOIN
  LEAVE
  POST
  LIKE
  COMMENT
  DELETE
  REPORT
}

model User {
  id             String         @id @default(cuid())
  email          String?        @unique
  name           String?
  username       String?        @unique
  avatarUrl      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lastActive     DateTime       @default(now())
  isAnonymous    Boolean        @default(false)
  allowFollowers Boolean        @default(true)
  followers      Follow[]       @relation("UserFollowers")
  following      Follow[]       @relation("UserFollowing")
  hostedRooms    Room[]         @relation("RoomHost")
  joinedRooms    Room[]         @relation("RoomMembers")
  roomActivities RoomActivity[]
  posts          Post[]
  comments       Comment[]
  likes          Like[]
  chats          ChatMessage[]
}

model Room {
  id           String         @id @default(cuid())
  name         String
  description  String?
  date         DateTime
  isPrivate    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  hostId       String
  qrCodeUrl    String?
  activities   RoomActivity[]
  settings     RoomSettings?
  host         User           @relation("RoomHost", fields: [hostId], references: [id])
  members      User[]         @relation("RoomMembers")
  posts        Post[]
  chats        ChatMessage[]
  chatSettings ChatSettings?
}

model RoomSettings {
  id            String   @id @default(cuid())
  room          Room     @relation(fields: [roomId], references: [id])
  roomId        String   @unique
  isPrivate     Boolean  @default(false)
  isDisabled    Boolean  @default(false)
  allowComments Boolean  @default(false)
  allowLikes    Boolean  @default(false)
  allowChat     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RoomActivity {
  id        String           @id @default(cuid())
  roomId    String
  userId    String
  type      RoomActivityType // 'join', 'leave', 'post', 'like', 'comment'
  createdAt DateTime         @default(now())
  room      Room             @relation(fields: [roomId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@index([roomId])
  @@index([userId])
  @@index([createdAt])
}

model Post {
  id        String    @id @default(cuid())
  mediaUrl  String
  mediaType String
  caption   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  roomId    String
  user      User      @relation(fields: [userId], references: [id])
  room      Room      @relation(fields: [roomId], references: [id])
  comments  Comment[]
  likes     Like[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id])
  following   User     @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String
  isPinned  Boolean  @default(false)
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([roomId])
  @@index([userId])
  @@index([createdAt])
}

model ChatSettings {
  id                 String  @id @default(cuid())
  roomId             String  @unique
  isEnabled          Boolean @default(true)
  allowGuestMessages Boolean @default(true)
  slowMode           Boolean @default(false)
  slowModeInterval   Int     @default(0) // Seconds between messages
  requireModeration  Boolean @default(false)
  room               Room    @relation(fields: [roomId], references: [id])
}
