generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  username         String?   @unique
  name             String?
  avatarUrl        String?
  bio              String?
  dob              DateTime? //Date of birth
  role             UserRole  @default(USER)
  isAnonymous      Boolean   @default(false)
  allowFollowers   Boolean   @default(true)
  isPrivateProfile Boolean   @default(false)
  lastActive       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  //Relations
  posts                  Post[]
  comments               Comment[]
  likes                  Like[]
  hostedEvents           Event[]         @relation("HostedEvents")
  joinedEvents           Event[]         @relation("JoinedEvents")
  following              Follow[]        @relation("Following")
  followers              Follow[]        @relation("Followers")
  roles                  EventRole[]
  attendees              Attendee[]
  chats                  ChatMessage[]
  eventLogs              EventActivity[]
  sentFollowRequests     FollowRequest[] @relation("Requestor")
  receivedFollowRequests FollowRequest[] @relation("Target")
  feedbacks              Feedback[]
}

model Event {
  id          String   @id @default(cuid())
  name        String
  type        String
  description String?
  location    String?
  dateTime    DateTime
  qrCodeUrl   String?
  coverImage  String?
  slug        String?  @unique
  pinCode     String?  @unique // Optional field to store PIN code (if accessType = PIN_REQUIRED)

  // Settings
  isPrivate        Boolean    @default(false)
  requiresApproval Boolean    @default(false)
  isDisabled       Boolean    @default(false)
  allowComments    Boolean    @default(true)
  allowLikes       Boolean    @default(true)
  allowChat        Boolean    @default(false)
  allowPosts       Boolean    @default(true)
  accessType       AccessType @default(LINK_ONLY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hostId    String
  host      User     @relation("HostedEvents", fields: [hostId], references: [id])

  // Relations
  members      User[]          @relation("JoinedEvents")
  attendees    Attendee[]
  posts        Post[]
  chats        ChatMessage[]
  chatSettings ChatSettings?
  roles        EventRole[]
  eventLogs    EventActivity[]
}

model EventActivity {
  id        String            @id @default(cuid())
  eventId   String
  userId    String
  type      EventActivityType
  createdAt DateTime          @default(now())
  event     Event             @relation(fields: [eventId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([eventId])
  @@index([userId])
}

model ChatSettings {
  id                 String   @id @default(cuid())
  eventId            String   @unique
  isEnabled          Boolean  @default(true)
  allowGuestMessages Boolean  @default(true)
  slowMode           Boolean  @default(false)
  slowModeInterval   Int      @default(0)
  requireModeration  Boolean  @default(false)
  muteList           Json? // List of muted users by ID
  banList            Json? // List of banned users by ID
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())
  event              Event    @relation(fields: [eventId], references: [id])
}

model Post {
  id        String      @id @default(cuid())
  caption   String?
  media     PostMedia[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userId    String
  eventId   String
  user      User        @relation(fields: [userId], references: [id])
  event     Event       @relation(fields: [eventId], references: [id])
  comments  Comment[]
  likes     Like[]
}

model PostMedia {
  id        String    @id @default(cuid())
  postId    String
  url       String
  type      MediaType // Enum to specify media type
  order     Int       @default(0) // To maintain order of media in a post
  createdAt DateTime  @default(now())
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
}

enum MediaType {
  IMAGE
  VIDEO
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id])
  following   User     @relation("Followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model FollowRequest {
  id           String   @id @default(cuid())
  requestorId  String
  targetUserId String
  createdAt    DateTime @default(now())
  requestor    User     @relation("Requestor", fields: [requestorId], references: [id])
  target       User     @relation("Target", fields: [targetUserId], references: [id])

  @@unique([requestorId, targetUserId])
}

model Attendee {
  id        String         @id @default(cuid())
  userId    String
  eventId   String
  status    AttendeeStatus @default(APPROVED)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id])
  event     Event          @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  eventId   String
  user      User     @relation(fields: [userId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])
}

model EventRole {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}

enum Role {
  ADMIN
  MODERATOR
  MEMBER
}

enum UserRole {
  ADMIN
  USER
  PARTNER
  MEMBER
}

enum EventActivityType {
  JOIN
  LEAVE
  POST
  LIKE
  COMMENT
  DELETE
  REPORT
}

enum AccessType {
  LINK_ONLY // Invite through direct links or QR codes
  PIN_REQUIRED // Requires entering a PIN code to access
  APPROVAL_REQUIRED // Requires host approval for access
}

model Forms {
  id        String            @id @default(cuid())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  email     String
  name      String?
  phone     String?
  subject   String?
  message   String?
  type      FormsType         @default(CONTACT)
  status    NewsletterStatus?
  userId    String?

  @@unique([email, userId])
}

enum NewsletterStatus {
  APPROVED
  UNSUBSCRIBED
  AUTO_ARCHIVED
}

enum FormsType {
  CONTACT
  NEWSLETTER
}

enum AttendeeStatus {
  PENDING
  APPROVED
  REJECTED
}

model Feedback {
  id        String           @id @default(cuid())
  userId    String
  type      FeedbackType
  rating    Int
  message   String?
  category  FeedbackCategory
  status    FeedbackStatus   @default(PENDING)
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}

enum FeedbackType {
  ACCOUNT_SETUP
  EVENT_EXPERIENCE
  APP_USABILITY
  BUG_REPORT
  FEATURE_REQUEST
  OTHER
}

enum FeedbackCategory {
  UI_UX
  PERFORMANCE
  FUNCTIONALITY
  CONTENT
  TECHNICAL
  GENERAL
}

enum FeedbackStatus {
  PENDING
  REVIEWED
  RESOLVED
  ARCHIVED
}
