generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String          @id @default(cuid())
  email           String?         @unique
  name            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  isAnonymous     Boolean         @default(false)
  lastActive      DateTime        @default(now())
  allowFollowers  Boolean         @default(true)
  avatarUrl       String?
  username        String?         @unique
  chats           ChatMessage[]
  comments        Comment[]
  hostedEvents    Event[]         @relation("EventHost")
  joinedEvents    Event[]         @relation("EventMembers")
  eventActivities EventActivity[]
  following       Follow[]        @relation("UserFollowing")
  followers       Follow[]        @relation("UserFollowers")
  likes           Like[]
  posts           Post[]
  attendees       Attendee[]
}

model Event {
  id           String          @id @default(cuid())
  name         String
  description  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  hostId       String
  qrCodeUrl    String?
  coverImage   String?
  dateTime     DateTime        @default(now())
  location     String?
  chats        ChatMessage[]
  chatSettings ChatSettings?
  host         User            @relation("EventHost", fields: [hostId], references: [id])
  members      User[]          @relation("EventMembers")
  attendees    Attendee[]
  activities   EventActivity[]
  settings     EventSettings?
  Post         Post[]
}

model EventSettings {
  id            String   @id @default(cuid())
  roomId        String   @unique
  isPrivate     Boolean  @default(false)
  isDisabled    Boolean  @default(false)
  allowComments Boolean  @default(false)
  allowLikes    Boolean  @default(false)
  allowChat     Boolean  @default(false)
  allowPosts    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  event         Event    @relation(fields: [roomId], references: [id])
}

model EventActivity {
  id        String            @id @default(cuid())
  roomId    String
  userId    String
  type      EventActivityType
  createdAt DateTime          @default(now())
  Event     Event             @relation(fields: [roomId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([roomId])
  @@index([userId])
}

model Post {
  id        String    @id @default(cuid())
  mediaUrl  String
  mediaType String
  caption   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  eventId   String
  comments  Comment[]
  likes     Like[]
  event     Event     @relation(fields: [eventId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id])
  following   User     @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String
  isPinned  Boolean  @default(false)
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [roomId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([roomId])
}

model ChatSettings {
  id                 String  @id @default(cuid())
  roomId             String  @unique
  isEnabled          Boolean @default(true)
  allowGuestMessages Boolean @default(true)
  slowMode           Boolean @default(false)
  slowModeInterval   Int     @default(0)
  requireModeration  Boolean @default(false)
  event              Event   @relation(fields: [roomId], references: [id])
}

model Attendee {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  createdAt DateTime @default(now())
}

enum EventActivityType {
  JOIN
  LEAVE
  POST
  LIKE
  COMMENT
  DELETE
  REPORT
}
