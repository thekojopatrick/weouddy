generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @db.Uuid
  email            String?   @unique
  username         String?   @unique
  name             String?
  avatarUrl        String?
  bio              String?
  dob              DateTime? //Date of birth
  role             UserRole  @default(USER)
  isAnonymous      Boolean   @default(false)
  allowFollowers   Boolean   @default(true)
  isPrivateProfile Boolean   @default(false)
  lastActive       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  //Relations
  vendors                Vendor[]
  posts                  Post[]
  comments               Comment[]
  likes                  Like[]
  hostedEvents           Event[]           @relation("HostedEvents")
  attendeeEvents         Attendee[]        @relation("UserAttendee")
  following              Follow[]          @relation("Following")
  followers              Follow[]          @relation("Followers")
  roles                  EventRole[]
  chats                  ChatMessage[]
  eventLogs              EventActivity[]
  sentFollowRequests     FollowRequest[]   @relation("Requestor")
  receivedFollowRequests FollowRequest[]   @relation("Target")
  feedbacks              Feedback[]
  messageReactions       MessageReaction[]
  vendorReviews          VendorReview[]
  Booking                Booking[]
}

model Event {
  id          String   @id @default(cuid())
  name        String
  type        String
  description String?
  location    String?
  dateTime    DateTime
  qrCodeUrl   String?
  coverImage  String?
  slug        String?  @unique
  pinCode     String?  @unique // Optional field to store PIN code (if accessType = PIN_REQUIRED)

  vendorBudget     Float?
  vendorCosts      Json? // {bookedVendors: [{id: "ven_123", cost: 2000}]}
  // Settings
  isPrivate        Boolean    @default(false)
  requiresApproval Boolean    @default(false)
  isDisabled       Boolean    @default(false)
  allowComments    Boolean    @default(true)
  allowLikes       Boolean    @default(true)
  allowChat        Boolean    @default(false)
  allowPosts       Boolean    @default(true)
  accessType       AccessType @default(DIRECT_PASS)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hostId    String   @db.Uuid
  host      User     @relation("HostedEvents", fields: [hostId], references: [id])

  // Relations
  attendees    Attendee[]      @relation("EventAttendee")
  posts        Post[]
  chats        ChatMessage[]
  chatSettings ChatSettings?
  roles        EventRole[]
  eventLogs    EventActivity[]
  eventVendors EventVendor[]

  @@index([hostId])
  @@index([createdAt])
  @@index([isDisabled, isPrivate, location, type])
  @@index([hostId, createdAt])
  @@index([isDisabled, createdAt])
}

model Attendee {
  id        String         @id @default(cuid())
  userId    String         @db.Uuid
  eventId   String
  status    AttendeeStatus @default(APPROVED)
  createdAt DateTime       @default(now())

  // Relations
  user  User  @relation("UserAttendee", fields: [userId], references: [id])
  event Event @relation("EventAttendee", fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@index([eventId, userId])
  @@index([userId, status])
  @@index([eventId, status])
}

model EventActivity {
  id        String            @id @default(cuid())
  eventId   String
  userId    String            @db.Uuid
  type      EventActivityType
  createdAt DateTime          @default(now())
  event     Event             @relation(fields: [eventId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([eventId])
  @@index([userId])
}

model ChatSettings {
  id                 String   @id @default(cuid())
  eventId            String   @unique
  isEnabled          Boolean  @default(true)
  allowGuestMessages Boolean  @default(true)
  slowMode           Boolean  @default(false)
  slowModeInterval   Int      @default(0)
  requireModeration  Boolean  @default(false)
  muteList           Json? // List of muted users by ID
  banList            Json? // List of banned users by ID
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())
  event              Event    @relation(fields: [eventId], references: [id])
}

model Post {
  id        String      @id @default(cuid())
  caption   String?
  media     PostMedia[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userId    String      @db.Uuid
  eventId   String
  user      User        @relation(fields: [userId], references: [id])
  event     Event       @relation(fields: [eventId], references: [id])
  comments  Comment[]
  likes     Like[]

  @@index([eventId])
  @@index([userId])
}

model PostMedia {
  id        String    @id @default(cuid())
  postId    String
  url       String
  type      MediaType // Enum to specify media type
  order     Int       @default(0) // To maintain order of media in a post
  createdAt DateTime  @default(now())
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
}

enum MediaType {
  IMAGE
  VIDEO
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @db.Uuid
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])

  @@index([postId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String   @db.Uuid
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  // Relations
  follower  User @relation("Following", fields: [followerId], references: [id])
  following User @relation("Followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model FollowRequest {
  id           String   @id @default(cuid())
  requestorId  String   @db.Uuid
  targetUserId String   @db.Uuid
  createdAt    DateTime @default(now())

  // Relations
  requestor User @relation("Requestor", fields: [requestorId], references: [id])
  target    User @relation("Target", fields: [targetUserId], references: [id])

  @@unique([requestorId, targetUserId])
}

model ChatMessage {
  id        String        @id @default(cuid())
  content   String
  isPinned  Boolean       @default(false)
  status    MessageStatus @default(SENT)
  createdAt DateTime      @default(now())
  userId    String        @db.Uuid
  eventId   String

  // Relations
  user      User              @relation(fields: [userId], references: [id])
  event     Event             @relation(fields: [eventId], references: [id])
  reactions MessageReaction[]

  // Add vendor context
  vendorId String? // Reference to vendor being discussed
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  @@index([eventId])
  @@index([userId])
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model MessageReaction {
  id        String      @id @default(cuid())
  emoji     String
  messageId String
  userId    String      @db.Uuid
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model EventRole {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  eventId   String
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}

enum Role {
  ADMIN
  MODERATOR
  MEMBER
}

enum UserRole {
  ADMIN
  USER
  VENDOR
  PARTNER
  MEMBER
}

enum EventActivityType {
  JOIN
  LEAVE
  POST
  LIKE
  COMMENT
  DELETE
  REPORT
  RESQUEST_PENDING
  ACCESS_DENIED
  ACCESS_GRANTED
}

enum AccessType {
  DIRECT_PASS //  Direct access through links or QR codes
  PIN_REQUIRED // Requires entering a PIN code to access
  INVITE_ONLY // Requires host approval for access
}

model Forms {
  id        String            @id @default(cuid())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  email     String
  name      String?
  phone     String?
  subject   String?
  message   String?
  type      FormsType         @default(CONTACT)
  status    NewsletterStatus?
  userId    String?

  @@unique([email, userId])
}

enum NewsletterStatus {
  APPROVED
  UNSUBSCRIBED
  AUTO_ARCHIVED
}

enum FormsType {
  CONTACT
  NEWSLETTER
}

enum AttendeeStatus {
  JOINED
  PENDING
  APPROVED
  DENIED
}

model Feedback {
  id        String           @id @default(cuid())
  userId    String           @db.Uuid
  type      FeedbackType
  rating    Int
  message   String?
  category  FeedbackCategory
  status    FeedbackStatus   @default(PENDING)
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}

enum FeedbackType {
  ACCOUNT_SETUP
  EVENT_EXPERIENCE
  APP_USABILITY
  BUG_REPORT
  FEATURE_REQUEST
  OTHER
}

enum FeedbackCategory {
  UI_UX
  PERFORMANCE
  FUNCTIONALITY
  CONTENT
  TECHNICAL
  GENERAL
}

enum FeedbackStatus {
  PENDING
  REVIEWED
  RESOLVED
  ARCHIVED
}

//Vendors Management

enum VendorType {
  VENUE
  CATERER
  PHOTOGRAPHER
  VIDEOGRAPHER
  ENTERTAINMENT
  DECOR
  TRANSPORTATION
  PLANNER
  STYLIST
  RENTAL
  CORPORATE
}

enum PriceRange {
  BUDGET
  MIDRANGE
  LUXURY
  CUSTOM
}

enum TravelScope {
  LOCAL_ONLY
  NATIONAL
  INTERNATIONAL
  NATIONAL_AND_INTERNATIONAL
}

model Vendor {
  id           String     @id @default(cuid())
  name         String
  type         VendorType
  services     String[] // ["Wedding Photography", "Corporate Events"]
  priceRange   PriceRange
  location     String? // Geocodable address
  rating       Float?     @default(0)
  totalReviews Int        @default(0)

  // AI
  aiTags     String[] // AI-generated tags for filtering and recommendations
  aiMetadata Json? // For ML features (embedding vectors, etc)

  // Contact info
  contactEmail String?
  phone        String?
  website      String?

  // Preferences
  travelScope   TravelScope @default(LOCAL_ONLY)
  travelFee     Float?
  servingCities String[] // Cities vendor primarily serves
  travelNotes   String? // Additional travel policy details

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  // Relations
  operations VendorOperations?
  attributes VendorAttribute[]
  packages   VendorPackage[]
  events     EventVendor[]
  reviews    VendorReview[]
  messages   ChatMessage[]
  bookings   Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([location])
  @@index([priceRange])
  @@index([rating])
  @@index([userId])
}

model VendorOperations {
  id       String @id @default(cuid())
  vendorId String @unique // Links to VendorMetadata
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  // Business hours
  businessHours Json?

  // Availability
  availability Json? // Store time slots as JSON (e.g., {"2024-09-01": ["9:00 AM", "2:00 PM"]})

  // Performance metrics
  completionRate   Float? // % of bookings completed successfully
  responseTime     Int? // Average time to respond to inquiries
  cancellationRate Float? // % of bookings cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
}

model VendorAttribute {
  id       String @id @default(cuid())
  vendorId String
  key      String // "capacity", "menuType", "equipment"
  value    String // "500", "Vegetarian", "4K Cameras"
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, key])
}

model VendorPackage {
  id          String  @id @default(cuid())
  vendorId    String
  name        String // "Premium Wedding Package"
  description String?
  price       Float?

  inclusions String[] // ["8hr Coverage", "2 Photographers", "Edited Photos"]

  basePrice     Float
  surgePrice    Float? // For high-demand periods
  discountRules Json? // E.g., {"earlyBird": 0.1, "groupDiscount": 0.15}

  vendor  Vendor    @relation(fields: [vendorId], references: [id])
  Booking Booking[]
}

model EventVendor {
  id       String       @id @default(cuid())
  eventId  String
  vendorId String
  status   VendorStatus @default(PENDING)
  notes    String?
  event    Event        @relation(fields: [eventId], references: [id])
  vendor   Vendor       @relation(fields: [vendorId], references: [id])

  @@unique([eventId, vendorId])
}

model Booking {
  id       String        @id @default(cuid())
  date     DateTime
  timeSlot String // "9:00 AM"
  status   BookingStatus @default(PENDING)
  notes    String?

  vendorId  String
  userId    String  @db.Uuid
  packageId String?

  vendor  Vendor         @relation(fields: [vendorId], references: [id])
  user    User           @relation(fields: [userId], references: [id])
  package VendorPackage? @relation(fields: [packageId], references: [id])

  reviews VendorReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([userId])
  @@index([date])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model VendorReview {
  id        String  @id @default(cuid())
  rating    Int
  comment   String?
  userId    String  @db.Uuid
  vendorId  String
  bookingId String?

  user    User     @relation(fields: [userId], references: [id])
  vendor  Vendor   @relation(fields: [vendorId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([vendorId])
  @@index([userId])
}

enum VendorStatus {
  PENDING
  CONTACTED
  BOOKED
  DECLINED
}
