generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String?         @unique
  username       String?         @unique
  name           String?
  avatarUrl      String?
  bio            String?
  dob            DateTime? //Date of birth
  role           UserRole        @default(USER)
  isAnonymous    Boolean         @default(false)
  allowFollowers Boolean         @default(true)
  lastActive     DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  posts          Post[]
  comments       Comment[]
  likes          Like[]
  hostedEvents   Event[]         @relation("HostedEvents")
  joinedEvents   Event[]         @relation("JoinedEvents")
  following      Follow[]        @relation("Following")
  followers      Follow[]        @relation("Followers")
  roles          EventRole[]
  attendees      Attendee[]
  chats          ChatMessage[]
  eventLogs      EventActivity[]
}

model Event {
  id            String          @id @default(cuid())
  name          String
  type          String
  description   String?
  location      String?
  dateTime      DateTime
  qrCodeUrl     String?
  coverImage    String?
  slug          String?         @unique
  isPrivate     Boolean         @default(false)
  isDisabled    Boolean         @default(false)
  allowComments Boolean         @default(true)
  allowLikes    Boolean         @default(true)
  allowChat     Boolean         @default(false)
  allowPosts    Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  hostId        String
  host          User            @relation("HostedEvents", fields: [hostId], references: [id])
  members       User[]          @relation("JoinedEvents")
  attendees     Attendee[]
  posts         Post[]
  chats         ChatMessage[]
  chatSettings  ChatSettings?
  roles         EventRole[]
  eventLogs     EventActivity[]
}

model EventActivity {
  id        String            @id @default(cuid())
  eventId   String
  userId    String
  type      EventActivityType
  createdAt DateTime          @default(now())
  event     Event             @relation(fields: [eventId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([eventId])
  @@index([userId])
}

model ChatSettings {
  id                 String   @id @default(cuid())
  eventId            String   @unique
  isEnabled          Boolean  @default(true)
  allowGuestMessages Boolean  @default(true)
  slowMode           Boolean  @default(false)
  slowModeInterval   Int      @default(0)
  requireModeration  Boolean  @default(false)
  muteList           Json? // List of muted users by ID
  banList            Json? // List of banned users by ID
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())
  event              Event    @relation(fields: [eventId], references: [id])
}

model Post {
  id        String      @id @default(cuid())
  caption   String?
  media     PostMedia[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userId    String
  eventId   String
  user      User        @relation(fields: [userId], references: [id])
  event     Event       @relation(fields: [eventId], references: [id])
  comments  Comment[]
  likes     Like[]
}

model PostMedia {
  id        String    @id @default(cuid())
  postId    String
  url       String
  type      MediaType // Enum to specify media type
  order     Int       @default(0) // To maintain order of media in a post
  createdAt DateTime  @default(now())
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
}

enum MediaType {
  IMAGE
  VIDEO
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id])
  following   User     @relation("Followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Attendee {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  eventId   String
  user      User     @relation(fields: [userId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])
}

model EventRole {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}

enum Role {
  ADMIN
  MODERATOR
  MEMBER
}

enum UserRole {
  ADMIN
  USER
  PARTNER
  MEMBER
}

enum EventActivityType {
  JOIN
  LEAVE
  POST
  LIKE
  COMMENT
  DELETE
  REPORT
}
